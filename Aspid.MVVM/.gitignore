# Unity dev project. Based on https://github.com/github/gitignore/blob/main/Unity.gitignore and cut down to what this
# project produces; OS and IDE files are ignored by the root .gitignore.

# Folders the Editor creates and rebuilds
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# Memory Profiler captures can get large and may hold sensitive data
/[Mm]emoryCaptures/

# Recorder output can get large
/[Rr]ecordings/

# Solution and project files Unity regenerates for the IDE
*.csproj
*.sln
*.tmp
.vsconfig

# Debug symbols
*.pdb
*.pdb.meta

# Crash reports
sysinfo.txt
mono_crash.*

# Builds and exported packages
*.apk
*.aab
*.app
*.unitypackage
*.unitypackage.meta

# Scenes the Test Runner leaves behind when a PlayMode run is interrupted
/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

# Addressables content builds (com.unity.localization depends on Addressables)
/[Ss]erver[Dd]ata/
/[Aa]ssets/[Ss]treamingAssets/aa*
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Samples installed from the package into the project are not part of the repo
/[Aa]ssets/Samples/
/[Aa]ssets/Samples.meta

# Auto-generated Project Auditor settings. Default values only, dev-project-local.
/[Pp]roject[Ss]ettings/ProjectAuditorSettings.asset
